{
  "schema": "automatos-theme/v1",
  "id": "automatos/play",
  "name": "Play",
  "version": "1.3.0",
  "description": "Automatos with Auto the mascot: a chat with Auto, a shelf of Deliverables, and looks you make your own.",
  "engines": { "automatos": "^1.1.0", "sdk": "^1.3.0" },
  "base": "studio",
  "htmlClass": "play",
  "minWidth": 360,
  "tone": "from-look",
  "slots": ["frame@1", "lookEditor@1", "styleSheet@1", "notFound@1", "asleep@1"],
  "pages": {
    "/chat": { "mode": "own", "keepCorePage": ["repo", "runtime", "mode"] },
    "/deliverables": { "mode": "own", "keepCorePage": ["tab", "post", "artifact_type"] }
  },
  "routes": ["conversations"],
  "nav": [
    { "id": "nav-play-conversations", "label": "Conversations", "path": "/x/conversations" },
    { "id": "nav-play-looks", "label": "Look", "path": "/looks" },
    { "id": "nav-play-style-sheet", "label": "Style sheet", "path": "/looks/style" }
  ],
  "uses": ["assets", "cards", "chat", "context", "deliverables", "events", "looks", "navigation", "pages-command-center", "proactive", "storage", "theme", "voice"],
  "look": "ember",
  "previews": [
    "assets/previews/ember.png",
    "assets/previews/obsidian.png",
    "assets/previews/aurora.png",
    "assets/previews/workshop.png",
    "assets/previews/daylight.png",
    "assets/previews/ember-deliverables.png",
    "assets/previews/ember-looks.png"
  ],
  "mascot": { "states": ["hello", "idle", "listening", "thinking", "working", "searching", "reading", "celebrate", "oops", "sleeping", "lost", "loading"] },
  "mobile": { "fromLooks": true, "mascot": "clips" }
}
