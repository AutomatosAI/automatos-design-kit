{
  "name": "@automatos/theme-hud",
  "version": "1.0.1",
  "description": "HUD, the Automatos theme as a command deck, built as an installable theme package (automatos/hud).",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack": "automatos-theme check design . && automatos-theme pack . --out out"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@automatos/look-kit": "0.1.0",
    "@automatos/mascot": "0.1.0"
  },
  "devDependencies": {
    "@automatos/eslint-plugin": "0.1.0",
    "@automatos/theme-cli": "0.1.0",
    "@automatos/theme-harness": "0.1.0",
    "@automatos/vite-preset": "0.1.0",
    "eslint": "9.39.5"
  },
  "peerDependencies": {
    "@automatos/theme-sdk": "1.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
