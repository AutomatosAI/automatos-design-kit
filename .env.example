# Where your local Automatos backend runs. Read on the server only, never sent to the browser.
# Use http://backend:8000 when Play runs in a container on the automatos_network Docker network.
AUTOMATOS_BACKEND_URL=http://localhost:8000

# Optional. Play answers only on localhost, 127.0.0.1 and [::1] (a guard against DNS rebinding).
# List any other host names you open it on, comma separated.
# PLAY_ALLOWED_HOSTS=play.lan
