{
  "permissions": {
    "allow": [
      "Read(/{{CLONE}}/**)",
      "Edit(/{{CLONE}}/**)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx automatos-theme *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(node *)",
      "Bash(npm exec *)",
      "Bash(npm x *)",
      "Bash(npx -c *)",
      "Bash(npm publish *)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(~/**)",
      "Edit(~/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [],
    "filesystem": {
      "allowRead": ["{{TOOLCHAIN}}"],
      "allowWrite": ["{{CLONE}}", "{{NPM_CACHE}}"],
      "denyWrite": ["{{CLONE}}/.claude"],
      "denyRead": ["~/"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "allowLocalBinding": true
    }
  }
}
